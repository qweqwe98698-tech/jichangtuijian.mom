---
import { featuredBrands, formatCostPerGB, protocolLabel, lineLabel } from '@data/brands';
import BrandLink from './BrandLink.astro';
import StatusBadge from './StatusBadge.astro';
import Disclosure from './Disclosure.astro';

/**
 * 主推位(商业位)。
 *
 * 这个组件存在的唯一理由是商业合作,不是评测结论。所以它的设计目标很反直觉:
 * **要让读者一眼看出这是商业位**,而不是让它伪装成排名第一。
 *
 * 三条约束:
 *
 * 1. 数据只读 `commercial.featured`,不读评分、不读榜单。主推不改变任何排序。
 * 2. 披露写在标题正下方,不是折叠在页脚的小字。读者看到品牌名之前就先看到「商业合作」。
 * 3. `caution` 必填并且和 `reason` 同等字号呈现。只写好话的主推位和广告没有区别,
 *    而这个站的全部价值来自敢说自己不知道什么——主推位不能是那个例外。
 *
 * 单家主推时风险更高:一家品牌孤零零出现在首页,天然会被读成「本站第一名」。
 * 所以文案里明确写出「这不是排名结果」,并把通往完整 16 家与客观排序的入口放在同一屏。
 */
const featured = featuredBrands();
const isSingle = featured.length === 1;
---

{
  featured.length > 0 && (
    <section class="feat section" id="featured" aria-labelledby="feat-heading">
      <div class="wrap">
        <div class="rail-section is-live">
          <div class="sec-head">
            <span class="tag-en">Sponsored Placement</span>
            <h2 id="feat-heading">本站主推:{featured.map((b) => b.name).join(' · ')}</h2>
          </div>

          {/* R10 要求的标准披露组件。它讲「推广关系」这件事,
              下面那段只补主推位特有的部分,不重复它已经说过的话 */}
          <Disclosure />

          <p class="feat-disclose">
            <strong>为什么{isSingle ? '这一家' : '这几家'}出现在这里:因为商业合作。</strong>
            <strong>这不是排名结果,也不是「本站第一名」。</strong>
            本站的编辑评分与场景榜单不读取任何商业字段,主推与否不会改变它们的顺序;
            品牌库的排序同样只按价格、流量、单位成本这类客观字段。想看完全不受商业关系影响的排列,
            直接去<a href="/airports/">品牌库</a>或<a href="/rankings/">场景榜单</a>。
          </p>

          <div class="feat-grid" class:list={{ 'is-single': isSingle }}>
            {featured.map((brand) => {
              const p = brand.vendor.pricing;
              const annual = p.basis === 'annual-equivalent';
              return (
                <article class="feat-card panel notch">
                  <div class="panel-in">
                    <header class="fc-head">
                      <span class="node-mark" aria-hidden="true" />
                      <div>
                        <h3>{brand.name}</h3>
                        <p class="fc-pos">{brand.editorial.positioning}</p>
                      </div>
                      <span class="fc-tag">商业合作</span>
                    </header>

                    <dl class="fc-specs">
                      <div>
                        <dt>入门标价</dt>
                        <dd>
                          <b>{p.entryPriceCNY}</b> 元
                          <span class="fc-basis">{annual ? '年付折算' : '月付'}</span>
                        </dd>
                      </div>
                      <div>
                        <dt>月流量</dt>
                        <dd>
                          <b>{p.trafficGB}</b> GB
                        </dd>
                      </div>
                      <div>
                        <dt>单位成本</dt>
                        <dd>
                          <b>{formatCostPerGB(brand)}</b> 元/GB
                        </dd>
                      </div>
                      <div>
                        <dt>线路</dt>
                        <dd class="fc-txt">{lineLabel(brand)}</dd>
                      </div>
                      <div>
                        <dt>协议</dt>
                        <dd class="fc-txt">{protocolLabel(brand)}</dd>
                      </div>
                      <div>
                        <dt>开业</dt>
                        <dd class="fc-txt">
                          {brand.vendor.since ? `${brand.vendor.since} 年` : '公开资料未标明'}
                        </dd>
                      </div>
                    </dl>

                    {annual && (
                      <p class="fc-annual">
                        <StatusBadge status="vendor" compact label="年付折算价" />
                        <span>
                          {p.entryPriceCNY} 元是把一年费用摊到每月算出来的,
                          <strong>要一次性付一整年</strong>,
                          月付拿不到这个数。它和月付品牌的标价不能直接比大小。
                        </span>
                      </p>
                    )}

                    <div class="fc-why">
                      <p class="fc-label">为什么推它</p>
                      <p>{brand.commercial.featured!.reason}</p>
                    </div>

                    <div class="fc-caution">
                      <p class="fc-label">谁应该跳过它</p>
                      <p>{brand.commercial.featured!.caution}</p>
                    </div>

                    {brand.commercial.promoText && (
                      <p class="fc-promo">
                        优惠:{brand.commercial.promoText}
                        {brand.commercial.promoCode && (
                          <>
                            ,优惠码 <code>{brand.commercial.promoCode}</code>
                          </>
                        )}
                        。以官方页面实际显示为准,本站不保证长期有效。
                      </p>
                    )}

                    <div class="fc-actions">
                      {/* 评测入口排在官网入口之前:先读再点,才是这个站想要的顺序 */}
                      <a class="btn btn-ghost" href={`/reviews/${brand.slug}/`}>
                        先看完整评测
                      </a>
                      <BrandLink brand={brand} />
                    </div>
                  </div>
                </article>
              );
            })}
          </div>

          <p class="feat-next">
            {isSingle ? '只看一家不足以做决定。' : '只看这几家不足以做决定。'}
            同价位还有别的选择,判断标准也不止价格——
            <a href="/airports/">按客观字段筛完整 16 家</a>、<a href="/compare/">把候选两两对照</a>
            ,或者先读
            <a href="/compare/how-to-choose-airport/">机场怎么选的六个维度</a>。 下单前建议再看一眼
            <a href="/risk/">风险预警</a>,尤其是关于付款周期的那部分。
          </p>
        </div>
      </div>
    </section>
  )
}

<style>
  .feat {
    padding-top: 0;
  }
  .feat-disclose {
    max-width: 76ch;
    margin-bottom: var(--s5);
    padding: 14px 16px;
    border: 1px dashed var(--border-strong);
    border-radius: var(--r-panel);
    font-size: 13.5px;
    line-height: 1.95;
    color: var(--text-muted);
  }
  .feat-disclose strong {
    color: var(--text);
  }

  .feat-grid {
    display: grid;
    gap: var(--s4);
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
  }
  /* 单家主推时不要拉满整行——一张横贯全宽的卡片读起来像横幅广告 */
  .feat-grid.is-single {
    grid-template-columns: minmax(0, 720px);
  }

  .feat-card .panel-in {
    padding: 18px 20px;
    display: grid;
    gap: 14px;
  }
  .fc-head {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: start;
    gap: 10px;
  }
  .fc-head h3 {
    font-size: 17px;
    line-height: 1.3;
  }
  .fc-pos {
    margin-top: 3px;
    font-size: 12.5px;
    color: var(--text-faint);
  }
  .fc-tag {
    flex: 0 0 auto;
    padding: 3px 8px;
    border: 1px solid var(--border-strong);
    border-radius: 3px;
    font: 600 10.5px/1.6 var(--font-mono);
    letter-spacing: 0.1em;
    color: var(--text-muted);
    white-space: nowrap;
  }

  .fc-specs {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px 10px;
    padding: 12px 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  .fc-specs dt {
    font-size: 11px;
    color: var(--text-faint);
    letter-spacing: 0.04em;
  }
  .fc-specs dd {
    margin-top: 3px;
    font-size: 13px;
    color: var(--text);
  }
  .fc-specs b {
    font: 600 16px/1 var(--font-mono);
  }
  .fc-txt {
    font-size: 12.5px !important;
    line-height: 1.5;
  }
  .fc-basis {
    margin-left: 5px;
    font-size: 11px;
    color: var(--text-faint);
  }

  .fc-annual {
    display: flex;
    align-items: flex-start;
    gap: 9px;
    flex-wrap: wrap;
    font-size: 12.5px;
    line-height: 1.85;
    color: var(--text-muted);
  }
  .fc-annual span {
    flex: 1 1 240px;
  }
  .fc-annual strong {
    color: var(--text);
  }

  .fc-label {
    font: 600 11px/1 var(--font-mono);
    letter-spacing: 0.12em;
    color: var(--text-faint);
    text-transform: uppercase;
    margin-bottom: 6px;
  }
  .fc-why p:last-child,
  .fc-caution p:last-child {
    font-size: 13.5px;
    line-height: 1.9;
    color: var(--text-muted);
  }
  /* caution 与 reason 同等字号,只用左边线区分——弱化它就等于把主推位做成广告 */
  .fc-caution {
    padding-left: 12px;
    border-left: 2px solid var(--danger);
  }
  .fc-why {
    padding-left: 12px;
    border-left: 2px solid var(--accent);
  }

  .fc-promo {
    font-size: 12.5px;
    line-height: 1.8;
    color: var(--text-faint);
  }
  .fc-promo code {
    padding: 1px 6px;
    font-family: var(--font-mono);
    font-size: 12px;
    background: var(--surface-2);
    border-radius: 3px;
    color: var(--text);
  }

  .fc-actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .feat-next {
    max-width: 76ch;
    margin-top: var(--s4);
    font-size: 13.5px;
    line-height: 1.95;
    color: var(--text-muted);
  }

  @media (max-width: 560px) {
    .fc-specs {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
