---
/**
 * 原创站点标记:菱形外框 = 路由节点,折线 = 中转路径,中心圆点 = 落地。
 * 与「信号与路径」设计语言同源,纯 SVG 无外部依赖。
 */
interface Props {
  size?: number;
  class?: string;
}
const { size = 30, class: className } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 32 32"
  class={className}
  aria-hidden="true"
  focusable="false"
>
  <rect
    x="4.5"
    y="4.5"
    width="23"
    height="23"
    rx="4"
    transform="rotate(45 16 16)"
    fill="none"
    stroke="currentColor"
    stroke-opacity=".38"
    stroke-width="1.3"></rect>
  <path
    d="M3 20 L11.5 20 L16 11.5 L20.5 20 L29 20"
    fill="none"
    stroke="var(--accent)"
    stroke-width="1.9"
    stroke-linecap="round"
    stroke-linejoin="round"></path>
  <circle cx="16" cy="11.5" r="3" fill="var(--accent)"></circle>
  <circle
    cx="16"
    cy="11.5"
    r="5.6"
    fill="none"
    stroke="var(--accent)"
    stroke-opacity=".35"
    stroke-width="1"></circle>
</svg>
