---
import { SITE, NAV } from '@config/site';
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import type { Crumb } from '@lib/schema';

interface Props {
  crumbs?: Crumb[];
}
const { crumbs = [] } = Astro.props;

const path = Astro.url.pathname;
/** 首页只在恰好为 / 时高亮,其余栏目按前缀匹配 */
const isCurrent = (href: string): boolean => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="site-head">
  <div class="wrap head-in">
    <a class="brandmark" href="/" aria-label={`${SITE.name} 首页`}>
      <Logo />
      <span class="bm-txt">
        <b>{SITE.name}</b>
        <span class="bm-sub">JICHANGTUIJIAN.MOM</span>
      </span>
    </a>

    <nav class="nav" aria-label="主导航">
      {
        NAV.map((item) => (
          <a
            href={item.href}
            title={item.description}
            aria-current={isCurrent(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="head-tools">
      <a class="searchbox" href="/search/" aria-label="站内搜索">
        <svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true">
          <circle cx="7" cy="7" r="4.6" fill="none" stroke="currentColor" stroke-width="1.4"
          ></circle>
          <path
            d="M10.5 10.5 L14 14"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linecap="round"></path>
        </svg>
        搜索线路 / 教程
        <kbd>/</kbd>
      </a>

      <ThemeToggle />

      <details class="menu-btn">
        <summary aria-label="打开菜单">
          <svg width="16" height="12" viewBox="0 0 16 12" aria-hidden="true">
            <path d="M0 1h16M0 6h11M0 11h16" stroke="currentColor" stroke-width="1.5"></path>
          </svg>
        </summary>
        <div class="m-panel">
          {NAV.map((item) => <a href={item.href}>{item.label}</a>)}
          <a href="/search/">站内搜索</a>
        </div>
      </details>
    </div>
  </div>

  {crumbs.length > 1 && <Breadcrumbs crumbs={crumbs} />}
</header>

<style>
  /* 本站主导航有 7 项(原设计语言按 5 项排布),需防止中等宽度下换行 */
  .nav a {
    white-space: nowrap;
  }

  /* 搜索框高度写死为 34px,一旦文字折行就会撑破边框。
     因此禁止它作为弹性项被压缩:宽度不够时直接整块隐藏,而不是挤成两行。 */
  .searchbox {
    flex: 0 0 auto;
    white-space: nowrap;
  }

  @media (max-width: 1180px) {
    .nav a {
      padding-inline: 8px;
      font-size: 13.5px;
    }
    .searchbox kbd {
      display: none;
    }
  }
  @media (max-width: 1100px) {
    .searchbox {
      display: none;
    }
  }
  /* 导航项多,提前一档切到移动端菜单,避免挤压 */
  @media (max-width: 980px) {
    .nav {
      display: none;
    }
    .menu-btn {
      display: block;
    }
  }
</style>
