---
/**
 * 合作披露。任何出现品牌推广链接的页面都必须渲染此组件(内链规则 R10)。
 * 位置放在推广链接之前或紧邻处,让读者在点击前就知道链接性质。
 */
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
---

<aside class={`disclosure${compact ? ' is-compact' : ''}`} aria-label="合作关系披露">
  <svg width="15" height="15" viewBox="0 0 16 16" aria-hidden="true">
    <circle cx="8" cy="8" r="6.8" fill="none" stroke="currentColor" stroke-width="1.3"></circle>
    <path d="M8 7.2v4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
    <circle cx="8" cy="4.9" r=".9" fill="currentColor"></circle>
  </svg>
  <p>
    本页出现的机场品牌与本站为<strong>推广合作关系</strong
    >,注册链接为推广链接,你通过它注册我们可能获得分成。 这不影响页面上的评分与结论——评分由公开字段按<a
      href="/editorial-policy/">固定公式</a
    >算出, 任何人拿到同一份数据都能复现同一结果。
  </p>
</aside>

<style>
  .disclosure {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    padding: 12px 14px;
    margin: var(--s5) 0;
    border: 1px dashed var(--border-strong);
    border-radius: var(--r-panel);
    background: var(--surface-2);
    color: var(--text-muted);
    font-size: 13px;
    line-height: 1.75;
  }
  .disclosure svg {
    flex: none;
    margin-top: 4px;
    color: var(--text-faint);
  }
  .disclosure p {
    margin: 0;
  }
  .disclosure strong {
    color: var(--text);
    font-weight: 600;
  }
  .disclosure a {
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .is-compact {
    margin: var(--s3) 0;
    padding: 9px 11px;
    font-size: 12.5px;
  }
</style>
