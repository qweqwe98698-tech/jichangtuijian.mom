---
import BaseLayout from '@layouts/BaseLayout.astro';
import BrandCard from '@components/BrandCard.astro';
import AnswerBox from '@components/AnswerBox.astro';
import NextStep from '@components/NextStep.astro';
import Disclosure from '@components/Disclosure.astro';
import { BRANDS } from '@data/brands';
import { rankedBrands } from '@lib/scoring';
import { itemListSchema } from '@lib/schema';
import { CATEGORY_META } from '../../content.config';

const meta = CATEGORY_META.reviews;
const monthly = rankedBrands({ basis: 'monthly' });
const annual = rankedBrands({ basis: 'annual-equivalent' });

const crumbs = [
  { name: '首页', href: '/' },
  { name: '机场评测', href: '/reviews/' },
];

const listSchema = itemListSchema(
  '机场品牌评测索引',
  [...monthly, ...annual].map(({ brand, score }) => ({
    name: `${brand.name}评测`,
    href: `/reviews/${brand.slug}/`,
    description: `${brand.editorial.positioning} · 编辑评分 ${score.overall.toFixed(1)}`,
  }))
);
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  crumbs={crumbs}
  schemas={[listSchema]}
>
  <section class="section">
    <div class="wrap">
      <div class="rail-section is-live">
        <header class="post-head">
          <span class="tag-en">Brand Reviews · {BRANDS.length} Airports</span>
          <h1>机场评测:{BRANDS.length} 家机场逐一拆解</h1>
        </header>

        <AnswerBox>
          <p>
            本站收录 {BRANDS.length} 家机场,每家都有一页独立评测,内容包括套餐规格、线路类型、协议支持、
            适合人群与需要权衡的地方。评分由公开字段按固定公式算出而非主观打分,并且严格区分 「厂商声明」与「本站实测」——目前所有品牌的流媒体与
            AI 能力均为厂商声明,尚未完成统一实测。
          </p>
        </AnswerBox>

        <p class="lede-sm">
          下面按月付与年付两组分开排列。<strong>这两组的价格不能直接比较</strong>:年付折算价的前提是
          一次性支付一年费用,把它和月付价放在同一个排行里会得出误导性的结论,所以我们把它们拆开。
        </p>

        <Disclosure />
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="wrap">
      <div class="rail-section">
        <div class="sec-head">
          <span class="tag-en">Monthly Billing · {monthly.length}</span>
          <h2>月付计价({monthly.length} 家)</h2>
          <p>价格即为每月实付金额,可以直接横向比较。按编辑评分从高到低排列。</p>
        </div>
        <div class="card-grid">
          {
            monthly.map(({ brand }, i) => (
              <BrandCard
                brand={brand}
                badge={i === 0 ? '综合评分最高' : `${brand.vendor.pricing.entryPriceCNY} 元档`}
              />
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="wrap">
      <div class="rail-section">
        <div class="sec-head">
          <span class="tag-en">Annual Equivalent · {annual.length}</span>
          <h2>年付折算计价({annual.length} 家)</h2>
          <p>
            这两家的低价建立在一次性支付一年费用的基础上。适合已经确定会长期使用的人,
            不适合还在试水阶段的新手——退款条件以官方说明为准。
          </p>
        </div>
        <div class="card-grid">
          {annual.map(({ brand }) => <BrandCard brand={brand} badge="年付折算" />)}
        </div>

        <NextStep
          label="把它们放在一张表里逐项对照"
          href="/compare/"
          reason="单看每家的评测页容易被各自的卖点带走。对照表把 16 家的价格、流量、线路、协议放进同一张表,差异会比分开看清楚得多。"
          alt={{ label: '不确定该看什么指标?先看选购标准', href: '/basics/' }}
        />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .post-head h1 {
    font-size: clamp(26px, 4vw, 38px);
    line-height: 1.3;
    margin: 12px 0;
  }
  .lede-sm {
    font-size: 15.5px;
    line-height: 1.9;
    color: var(--text-muted);
    max-width: 70ch;
    margin-top: var(--s4);
  }
  .lede-sm strong {
    color: var(--text);
  }
</style>
