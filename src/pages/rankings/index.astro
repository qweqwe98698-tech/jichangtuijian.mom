---
import BaseLayout from '@layouts/BaseLayout.astro';
import AnswerBox from '@components/AnswerBox.astro';
import NextStep from '@components/NextStep.astro';
import { RANKINGS, rankingBrands } from '@data/rankings';
import { itemListSchema } from '@lib/schema';

const cards = RANKINGS.map((r) => ({ ranking: r, count: rankingBrands(r).length }));

const crumbs = [
  { name: '首页', href: '/' },
  { name: '场景榜单', href: '/rankings/' },
];

const listSchema = itemListSchema(
  '机场场景榜单',
  RANKINGS.map((r) => ({
    name: r.heading,
    href: `/rankings/${r.slug}/`,
    description: r.description,
  }))
);
---

<BaseLayout
  title="机场排行榜:按使用场景分类的榜单"
  description="按预算、稳定性、流量规格、AI 工具、流媒体、新手友好度等不同场景分别筛选机场。每份榜单都公开筛选口径,并在名单之后说明这个选择的代价。"
  crumbs={crumbs}
  schemas={[listSchema]}
>
  <section class="section">
    <div class="wrap">
      <div class="rail-section is-live">
        <header class="post-head">
          <span class="tag-en">Rankings · {RANKINGS.length} Lists</span>
          <h1>机场排行榜:先确定场景,再看名单</h1>
        </header>

        <AnswerBox>
          <p>
            不存在一份适用于所有人的机场排行榜。同样 16 家机场,按价格排、按流量排、按线路等级排,
            会得出三份完全不同的名单。所以本站不做总排行,只做场景榜——你先确定自己属于哪种情况,
            再看对应的那一份。每份榜单都公开筛选条件,并且在名单之后写明这个选择要付出什么代价。
          </p>
        </AnswerBox>

        <div class="rank-grid">
          {
            cards.map(({ ranking, count }) => (
              <a class="rank-card panel notch" href={`/rankings/${ranking.slug}/`}>
                <span class="panel-in">
                  <span class="rc-count">{count} 家入选</span>
                  <span class="rc-title">{ranking.heading}</span>
                  <span class="rc-kw">{ranking.primaryKeyword}</span>
                  <span class="rc-desc">{ranking.description}</span>
                </span>
              </a>
            ))
          }
        </div>

        <h2 id="why">为什么每份榜单后面都要写「代价」</h2>
        <p>
          一份只讲优点的榜单,读起来很顺,但它把判断的成本转嫁给了你——等你买完用了一个月,
          才发现当初那个"最便宜"的选择在流量上根本不够用。我们的做法是把取舍前置:
          先按你的搜索意图给出名单,再把这个选择的代价摊开写清楚。愿意接受的人可以直接下单,
          觉得代价太大的人可以立刻转向另一份榜单,不用等交完学费才知道。
        </p>
        <p>
          这也意味着本站的榜单不会出现"全网最强""闭眼入"这类表述。
          筛选条件和排序规则全部公开在每一页上,你可以拿同一份数据自己复算。
        </p>

        <NextStep
          label="不确定自己属于哪种情况?先看对照表"
          href="/compare/"
          reason="如果连自己需要什么规格都还不确定,榜单帮不上忙。16 家的横向对照表能让你先建立价格与流量的直观概念,再回来挑对应的榜单。"
          alt={{ label: '完全没接触过机场?从这里开始', href: '/basics/' }}
        />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .post-head h1 {
    font-size: clamp(26px, 4vw, 38px);
    line-height: 1.3;
    margin: 12px 0;
  }
  .rank-grid {
    display: grid;
    gap: 14px;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    margin: var(--s5) 0;
  }
  .rank-card {
    color: inherit;
    display: block;
    transition: transform 0.2s cubic-bezier(0.2, 0.8, 0.3, 1);
  }
  .rank-card:hover {
    transform: translateY(-2px);
  }
  .rank-card .panel-in {
    display: block;
    padding: 18px 20px;
  }
  .rc-count {
    font: 600 11px/1 var(--font-mono);
    letter-spacing: 0.12em;
    color: var(--accent);
    display: block;
  }
  .rc-title {
    display: block;
    margin: 10px 0 6px;
    font-size: 16.5px;
    font-weight: 600;
    color: var(--text);
    line-height: 1.45;
  }
  .rank-card:hover .rc-title {
    color: var(--accent);
  }
  .rc-kw {
    display: inline-block;
    margin-bottom: 9px;
    padding: 3px 8px;
    border: 1px solid var(--border);
    border-radius: var(--r-chip);
    background: var(--surface-2);
    font-size: 11.5px;
    color: var(--text-faint);
  }
  .rc-desc {
    display: block;
    font-size: 13.5px;
    color: var(--text-muted);
    line-height: 1.8;
  }
</style>
