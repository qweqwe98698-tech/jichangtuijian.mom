---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import BrandCard from '@components/BrandCard.astro';
import AnswerBox from '@components/AnswerBox.astro';
import Disclosure from '@components/Disclosure.astro';
import RiskNotice from '@components/RiskNotice.astro';
import NextStep from '@components/NextStep.astro';
import Faq from '@components/Faq.astro';
import type { Ranking } from '@data/rankings';
import { RANKINGS, rankingBrands } from '@data/rankings';
import { costPerGB, lineLabel } from '@data/brands';
import { scoreBrand } from '@lib/scoring';
import { itemListSchema, articleSchema, faqSchema } from '@lib/schema';

export const getStaticPaths: GetStaticPaths = () =>
  RANKINGS.map((ranking) => ({ params: { slug: ranking.slug }, props: { ranking } }));

interface Props {
  ranking: Ranking;
}

const { ranking } = Astro.props;
const brands = rankingBrands(ranking);
const path = `/rankings/${ranking.slug}/`;

const faq = [
  {
    question: `${ranking.primaryKeyword}这份名单是怎么筛出来的?`,
    answer: `筛选条件是:${ranking.criteria.join(';')}。这些条件全部基于品牌公开资料中的客观字段,你可以拿同一份数据自己复算,应该得到完全相同的名单。`,
  },
  {
    question: '排在第一位的就是最适合我的吗?',
    answer:
      '不一定。榜单只反映在这一个筛选口径下的排序结果,它不知道你的月流量需求、使用时段、所在地区的网络环境和预算上限。名单的作用是把 16 家缩小到几家,最终选择仍然要看具体规格。',
  },
  {
    question: '这份名单多久更新一次?',
    answer:
      '价格与套餐数据每月复查一次,复查后名单会自动按新数据重排。筛选条件本身如果调整,会在编辑与评测规范页记录变更原因。',
  },
  {
    question: '榜单会因为合作关系被调整吗?',
    answer:
      '不会。名单由筛选条件与排序规则直接算出,没有人工干预的位次。本站与这些品牌确实是推广合作关系,正因如此我们把筛选口径完全公开——如果排序被人为调整过,你按同样条件复算就会发现对不上。',
  },
];

const schemas = [
  articleSchema({
    title: ranking.title,
    description: ranking.description,
    path,
    pubDate: new Date('2026-08-18'),
    updatedDate: new Date('2026-08-18'),
    authorName: '机场实测室编辑部',
    authorPath: '/authors/editorial-team/',
    section: '机场推荐',
    keywords: [ranking.primaryKeyword, ...ranking.secondaryKeywords],
  }),
  itemListSchema(
    ranking.heading,
    brands.map((b) => ({
      name: b.name,
      href: `/reviews/${b.slug}/`,
      description: `${b.editorial.positioning} · ${b.vendor.pricing.entryPriceCNY} 元 / ${b.vendor.pricing.trafficGB}GB`,
    }))
  ),
  faqSchema(faq),
];

const crumbs = [
  { name: '首页', href: '/' },
  { name: '场景榜单', href: '/rankings/' },
  { name: ranking.primaryKeyword, href: path },
];
---

<BaseLayout
  title={ranking.title}
  description={ranking.description}
  crumbs={crumbs}
  schemas={schemas}
  ogType="article"
  publishedTime={new Date('2026-08-18')}
  modifiedTime={new Date('2026-08-18')}
>
  <article class="section">
    <div class="wrap">
      <div class="rail-section is-live">
        <header class="post-head">
          <span class="tag-en">Ranking · {brands.length} Picks</span>
          <h1>{ranking.heading}</h1>
          <p class="post-meta">最近更新 2026-08-18 · 筛选自本站收录的 16 家机场</p>
        </header>

        <AnswerBox>
          <p>{ranking.answer}</p>
        </AnswerBox>

        <h2 id="criteria">这份名单的筛选口径</h2>
        <p>
          把口径先说清楚,你才能判断这份名单对你是否成立——如果某条标准和你的需求不符,直接跳过这份榜单更省时间。
        </p>
        <ol class="criteria-list">
          {ranking.criteria.map((c) => <li>{c}</li>)}
        </ol>

        <h2 id="picks">符合条件的机场</h2>
        <Disclosure />
        <div class="card-grid">
          {
            brands.map((b, i) => (
              <BrandCard
                brand={b}
                badge={i === 0 ? '本榜第一' : `第 ${i + 1} 位`}
                dimensions={
                  ranking.slug === 'value' || ranking.slug === 'cheap'
                    ? ['value', 'line']
                    : ['line', 'track']
                }
              />
            ))
          }
        </div>

        <div class="table-shell panel notch">
          <div class="panel-in">
            <div class="table-scroll">
              <table>
                <caption class="sr">{ranking.heading}的规格对照</caption>
                <thead>
                  <tr>
                    <th scope="col">品牌</th>
                    <th scope="col">入门价</th>
                    <th scope="col">月流量</th>
                    <th scope="col">元 / GB</th>
                    <th scope="col">线路</th>
                    <th scope="col">开业</th>
                    <th scope="col">编辑评分</th>
                  </tr>
                </thead>
                <tbody>
                  {
                    brands.map((b) => (
                      <tr>
                        <th scope="row">
                          <a href={`/reviews/${b.slug}/`}>{b.name}</a>
                        </th>
                        <td>
                          <span class="num">{b.vendor.pricing.entryPriceCNY}</span> 元
                          {b.vendor.pricing.basis === 'annual-equivalent' ? '(年付)' : ''}
                        </td>
                        <td>
                          <span class="num">{b.vendor.pricing.trafficGB}</span> GB
                        </td>
                        <td>
                          <span class="num">{costPerGB(b).toFixed(3)}</span>
                        </td>
                        <td>{lineLabel(b)}</td>
                        <td>{b.vendor.since ?? '—'}</td>
                        <td>
                          <span class="num">{scoreBrand(b).overall.toFixed(1)}</span>
                        </td>
                      </tr>
                    ))
                  }
                </tbody>
              </table>
            </div>
            <p class="scroll-hint">
              <span class="line"></span>小屏可左右滑动查看完整字段<span class="line"></span>
            </p>
          </div>
        </div>

        <h2 id="counterpoint">{ranking.counterpoint.title}</h2>
        <p>
          任何按单一维度排出来的榜单都有代价。下面这些不是免责声明,而是你在按这份名单下单之前
          应该先算清楚的账:
        </p>
        <RiskNotice
          title={ranking.counterpoint.title}
          badge="TRADE-OFF"
          items={ranking.counterpoint.items}
          fine="以上内容基于本站对公开资料的整理与行业常见情况的判断,不构成对任何具体服务方的指控或承诺。"
        />

        <Faq items={faq} />

        <NextStep
          label={ranking.nextStep.label}
          href={ranking.nextStep.href}
          reason={ranking.nextStep.reason}
          alt={{ label: '看全部 16 家的完整对照', href: '/compare/' }}
        />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .post-head h1 {
    font-size: clamp(25px, 3.8vw, 36px);
    line-height: 1.3;
    margin: 12px 0;
  }
  .post-meta {
    font-size: 13.5px;
    color: var(--text-faint);
  }
  .criteria-list {
    list-style: none;
    counter-reset: cr;
    display: grid;
    gap: 10px;
    margin: var(--s4) 0;
  }
  .criteria-list li {
    counter-increment: cr;
    position: relative;
    padding-left: 30px;
    font-size: 15px;
    line-height: 1.85;
    color: var(--text-muted);
  }
  .criteria-list li::before {
    content: counter(cr);
    position: absolute;
    left: 0;
    top: 3px;
    width: 20px;
    height: 20px;
    display: grid;
    place-items: center;
    border: 1px solid var(--border-strong);
    border-radius: var(--r-node);
    font: 600 11px/1 var(--font-mono);
    color: var(--accent);
  }
  tbody th a {
    color: var(--text);
  }
  tbody th a:hover {
    color: var(--accent);
  }
</style>
