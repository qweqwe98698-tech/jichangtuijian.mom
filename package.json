{
  "name": "jichangtuijian-mom",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "jichangtuijian.mom — 中文机场代理知识博客",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "astro check",
    "lint": "eslint . --ext .js,.mjs,.ts,.astro",
    "lint:fix": "eslint . --ext .js,.mjs,.ts,.astro --fix",
    "format": "prettier --write \"**/*.{js,mjs,ts,astro,md,mdx,json,css}\"",
    "format:check": "prettier --check \"**/*.{js,mjs,ts,astro,md,mdx,json,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:model": "node scripts/check-model.mjs",
    "check:profiles": "node scripts/check-profiles.mjs",
    "check:topics": "node scripts/audit-topic-coverage.mjs",
    "check:manifest": "node scripts/check-manifest.mjs docs/CONTENT-MANIFEST.json",
    "audit:evidence": "node scripts/audit-evidence.mjs",
    "diff:brands": "node --experimental-strip-types scripts/diff-brands.mjs",
    "gen:brand-maps": "node --experimental-strip-types scripts/gen-brand-maps.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:content": "node scripts/check-content.mjs",
    "check:all": "pnpm format:check && pnpm check:model && pnpm check:profiles && pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm check:links && pnpm check:content && pnpm check:topics && pnpm check:outlines && pnpm check:manifest && pnpm verify:release",
    "verify:release": "node scripts/verify-release.mjs",
    "check:outlines": "node scripts/audit-outline-uniqueness.mjs docs/brand-outlines/OUTLINES.json",
    "fix:frontmatter": "node scripts/normalize-frontmatter.mjs",
    "gen:og": "node scripts/gen-og-image.mjs"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.2",
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.2",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@pagefind/default-ui": "^1.5.2",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^10.8.1",
    "eslint-plugin-astro": "^3.1.0",
    "globals": "^17.11.0",
    "pagefind": "^1.5.2",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
